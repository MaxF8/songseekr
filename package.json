{
  "name": "songseekr",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"node --watch index.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client",
    "test": "node --test server/*.test.js && npm test --prefix client",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
